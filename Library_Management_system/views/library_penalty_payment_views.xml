<odoo>
    <record id="view_library_penalty_payment_form" model="ir.ui.view">
        <field name="name">library penalty payment form</field>
        <field name="model">library.penalty.payment</field>
        <field name="arch" type="xml">
            <form string="Penalty Payment">
                <sheet>
                    <group>
                        <field name="reference"/>
                        <field name="issue_id"/>
                        <field name="member_id"/>
                        <field name="amount"/>
                        <field name="payment_date"/>
                        <field name="payment_method"/>
                        <field name="state"/>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_confirm_payment"
                        type="object"
                        string="Confirm Payment"
                        class="btn-primary"/>
                    <button name="action_print_receipt"
                            type="object"
                            string="Print Receipt"
                            class="btn-secondary"
                            invisible="state != 'paid'"/>
                    <button string="Close"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
     <record id="view_library_penalty_payment_list" model="ir.ui.view">
        <field name="name">library penalty payment list</field>
        <field name="model">library.penalty.payment</field>
        <field name="arch" type="xml">
            <list>
                <field name="reference"/>
                <field name="member_id"/>
                <field name="amount"/>
                <field name="payment_date"/>
                <field name="payment_method"/>
                <field name="state"/>
            </list>
        </field>
    </record>
</odoo>