<odoo>
    <record id="book_issue_form" model="ir.ui.view">
        <field name="name">book issue form</field>
        <field name="model">book.issue</field>
        <field name="arch" type="xml">
            <form string="Book Issue">
                <header>
                    <button name="action_issue_book"
                            string="Issue"
                            type="object"
                            icon="fa-book"
                            class="btn-primary"
                            invisible="status != 'draft'"/>
                    <button name="action_return_book"
                            string="Return Book"
                            type="object"
                            class="btn btn-success"
                            icon="fa-undo"
                            invisible="status not in ['issued','pending']"/>
                    <button name="action_open_issue_form"
                            type="object"
                            class="btn btn-primary btn-sm"
                            string="Add Books"
                            icon="fa-plus"/>
                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="draft,issued,pending,returned"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-money">
                            <field name="payment_count"
                                   widget="statinfo"
                                   string="Payments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group string="Issue Information" col="2">
                        <field name="member_id"/>
                    </group>
                    <notebook>
                        <page string="Books">
                            <field name="book_line_ids">
                                <list editable="bottom">
                                    <field name="book_id"
                                           width="250"
                                           domain="[('is_book','=',True), ('id','not in', parent.selected_book_ids)]"/>
                                    <field name="issue_date" width="100"/>
                                    <field name="last_date_of_return" width="120"/>
                                    <field name="return_date" readonly="1"/>
                                    <field name="days_issued" width="70"/>
                                    <field name="to_return" width="60"/>
                                    <button name="action_update_return" string=""
                                        type="object"  icon="fa-calendar" class="btn-link"
                                        width="40" groups="library_management_system.group_librarian_admin"
                                        confirm="Are you sure you want to update the return date?"/>
                                    <field name="penalty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="book_issue_kanban_view" model="ir.ui.view">
        <field name="name">book.issue.kanban</field>
        <field name="model">book.issue</field>
        <field name="arch" type="xml">
        <kanban class="o_kanban_mobile">
            <field name="name"/>
            <field name="member_photo"/>
            <field name="member_id"/>
            <field name="penalty"/>
            <field name="status"/>
            <templates>
                <t t-name="card">
                    <div class="oe_kanban_global_click shadow-sm rounded p-3 mb-2 bg-white"
                         style="border-top:4px solid #875A7B; border-radius:12px;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="flex-grow-1">
                                <div class="fw-bold text-primary fs-5">
                                    <field name="name"/>
                                </div>
                                <div class="mt-1">
                                    👤 <field name="member_id"/>
                                </div>
                                <div class="mt-1">
                                    💰 Penalty:
                                    <span class="text-danger fw-bold">
                                        <field name="penalty"/>
                                    </span>
                                </div>
                                <div class="mt-1">
                                    📌 <field name="status"/>
                                </div>
                            </div>
                            <div class="ms-3 text-end">
                                <field name="member_photo"
                                       widget="image"
                                       options="{'size':[80,80]}"
                                       class="rounded-circle border"/>
                            </div>
                        </div>
                        <div class="mt-3 d-flex gap-2">
                            <button name="action_open_issue_form"
                                    type="object"
                                    class="btn btn-primary btn-sm">
                                Add Books
                            </button>
                            <button name="action_pay_penalty"
                                    type="object"
                                    class="btn btn-success btn-sm">
                                Pay Penalty
                            </button>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>
    <!-- List View -->
    <record id="book_issue_list" model="ir.ui.view">
        <field name="name">book issue list</field>
        <field name="model">book.issue</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="member_id"/>
                <field name="status"/>
                <field name="penalty"/>
            </list>
        </field>
    </record>
</odoo>