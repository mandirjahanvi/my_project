<odoo>
    <record id="view_library_member_list" model="ir.ui.view">
        <field name="name">library.member.list</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list string="Library Members">
                <field name="user_id"/>
                <field name="member_code"/>
                <field name="mobile"/>
                <field name="email"/>
                <field name="join_date"/>
                <field name="expiry_date"/>
                <field name="penalty_due"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <record id="view_library_member_form" model="ir.ui.view">
        <field name="name">library.member.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form string="Library Member">
                <sheet>
                    <div><button name="action_download_member_report" string="Download Receipt" type="object" class="btn-primary"/></div>
                    <div class="oe_title">
                        <h1>
                            <field name="photo" widget="image" class="oe_avatar"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="user_id"
                                    string="Member Name"/>
                            <field name="member_code"/>
                            <field name="membership_type"/>
                            <field name="aadhar_number"/>
                            <field name="gender"/>
                            <field name="active"/>
                        </group>

                        <group>
                            <field name="mobile"/>
                            <field name="email"/>
                            <field name="join_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Address">
                            <group>
                                <group>
                                    <field name="address"/>
                                    <field name="city"/>
                                </group>
                                <group>
                                    <field name="state"/>
                                    <field name="zip_code"/>
                                    <field name="country_id"/>
                                </group>
                            </group>
                        </page>

                        <page string="Library Details">
                            <group>
                                <group>
                                    <field name="penalty_due" readonly="1"/>
                                </group>
                                <group>
                                    <field name="membership_type"/>
                                </group>
                            </group>
                        </page>

                        <page string="Issued Books">
                            <field name="issue_ids">
                                <list>
                                    <field name="member_id"/>
                                    <field name="status"/>
                                    <field name="penalty"/>
                                    <field name="picking_id"/>
                                </list>
                            </field>
                        </page>

                        <page string="Notes">
                            <field name="notes"/>
                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_library_member_search" model="ir.ui.view">
        <field name="name">library.member.search</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
        <search>

            <field name="member_code"/>
            <field name="mobile"/>
            <field name="email"/>
            <filter string="Active"
                    name="active"
                    domain="[('active','=',True)]"/>
            <filter string="Inactive"
                    name="inactive"
                    domain="[('active','=',False)]"/>
            <filter string="Students"
                    name="student"
                    domain="[('membership_type','=','student')]"/>
            <filter string="Teachers"
                    name="teacher"
                    domain="[('membership_type','=','teacher')]"/>
            <filter string="Membership Type"
                    name="group_membership"
                    context="{'group_by':'membership_type'}"/>
        </search>
    </field>
</record>
</odoo>