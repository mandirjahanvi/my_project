<odoo>
    <record id="view_product_form" model="ir.ui.view">
        <field name="name">product form</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_issues"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-book">
                  <field name="issue_book_count" widget="statinfo" string=" Issues "/>
                    </button>
                </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <div class="oe_right">
                        <field name="image_1920" widget="image"
                               class="oe_avatar"
                               options="{'size': [150, 150]}"/>
                    </div>
                    <group>
                        <field name="author"/>
                        <field name="qty_available"/>
                        <field name="is_available"/>
                        <field name="default_code"/>
                        <field name="is_book"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_product_list" model="ir.ui.view">
        <field name="name">product list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="author"/>
                <field name="qty_available"/>
                <field name="is_available"/>
                <field name="default_code"/>
            </list>
        </field>
    </record>

    <record id="view_product1_kanban" model="ir.ui.view">
        <field name="name">view product kanban</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="author"/>
                <field name="qty_available"/>
                <field name="default_code"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record">
                            <div class="row">
                                <div class="col-8">
                                    <div><field name="default_code"/></div>
                                    <div><strong><field name="name"/></strong></div>
                                    <div><field name="author"/></div>
                                    <div t-attf-class="#{record.qty_available.raw_value == 0? 'text-danger' : 'text-success'}">
                                         Available: <field name="qty_available"/></div>
                                </div>
                                <div class="col-4 text-end">
                                <img t-att-src="'/web/image/product.template/' + record.id.raw_value + '/image_1920'"
                                     class="rounded img-fluid"
                                     style="max-height:100px;"/>
                            </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
       <record id="action_library_product" model="ir.actions.act_window">
            <field name="name">Library Books</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="views" eval="[
                (ref('library_management_system.view_product1_kanban'), 'kanban'),
                (ref('library_management_system.view_product_list'), 'list'),
                (ref('library_management_system.view_product_form'), 'form')]"/>
       </record>
</odoo>
