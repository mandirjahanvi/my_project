<odoo>
    <record id="view_hr_attendance_late_report_list" model="ir.ui.view">
        <field name="name">hr attendance late report list</field>
        <field name="model">hr.attendance.late.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="company_id"/>
                <field name="check_in"/>
                <field name="check_in_time"/>
                <field name="late_minutes"/>
                <field name="attendance_id"/>
            </list>
        </field>
    </record>
    <record id="view_hr_attendance_late_report_search" model="ir.ui.view">
    <field name="name">hr attendance late report search</field>
    <field name="model">hr.attendance.late.report</field>
    <field name="arch" type="xml">
        <search>
            <field name="employee_id"/>
            <field name="department_id"/>
            <field name="company_id"/>
            <filter string="This Month Late Check-ins" name="this_month" domain="[('check_in','>=',context_today().strftime('%%Y-%%m-01 00:00:00'))]"/>
            <filter string="Today Late Check-ins" name="today" domain="[('check_in', '>=', context_today().strftime('%%Y-%%m-%%d 00:00:00'))]"/>
                <group string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by':'employee_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by':'department_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by':'company_id'}"/>
                </group>
        </search>
    </field>

</record>
    <record id="action_hr_attendance_late_report" model="ir.actions.act_window">
        <field name="name">Late Check-in Report</field>
        <field name="res_model">hr.attendance.late.report</field>
        <field name="view_mode">list</field>
    </record>
</odoo>